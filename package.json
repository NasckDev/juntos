{
  "name": "juntos",
  "version": "0.2.0",
  "private": true,
  "description": "Finanças da casa, sozinho ou a dois: contas fixas que se lançam sozinhas, divisão justa, orçamento, metas e a planilha do Excel de volta.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "privacidade": "node scripts/verificar-privacidade.mjs",
    "test:e2e": "turbo run test:e2e",
    "test:prototipo": "playwright test -c prototipo/playwright.config.ts",
    "prints:prototipo": "node prototipo/gerar-prints.mjs",
    "verify": "npm run privacidade && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  }
}
