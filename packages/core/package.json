{
  "name": "@juntos/core",
  "version": "0.1.0",
  "private": true,
  "description": "Regras de negócio do Juntos em TypeScript puro: dinheiro, recorrência, divisão, orçamento, metas, projeção e planilhas.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
