# Copie para .env.local e preencha. Nunca versione o .env.local.

# Banco. Sem DATABASE_URL, o app usa PGlite local em .data/pglite (só para desenvolvimento).
DATABASE_URL=

# Autenticação (Better Auth). Gere o segredo com: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth).
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rotina diária (Vercel Cron). Qualquer texto aleatório longo.
CRON_SECRET=

# Notificações push. Gere com: npm run chaves:vapid -w web
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@example.com

# E-mail (opcional). Sem a chave, convites e avisos ficam só no app e no push.
RESEND_API_KEY=
EMAIL_FROM=Juntos <avisos@example.com>
